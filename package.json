{
  "name": "hemline",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "nodemon --ignore resumes/ --exec 'node --env-file=.env' server.js",
    "test": "vitest run",
    "test:live": "HEMLINE_LIVE=1 vitest run tests/live.test.js",
    "test:ui": "vitest run tests/ui.test.js",
    "test:ui-live": "HEMLINE_LIVE=1 vitest run tests/ui_live.test.js",
    "benchmark": "node --env-file=.env scripts/benchmark-models.js",
    "build": "node scripts/build-extension.mjs all --zip",
    "build:chrome": "node scripts/build-extension.mjs chrome",
    "build:firefox": "node scripts/build-extension.mjs firefox",
    "build:amo": "npm run vendor:sdk && node scripts/build-extension.mjs firefox --zip",
    "build:texmf": "node scripts/texlive/build-texmf.mjs",
    "vendor:sdk": "esbuild node_modules/@anthropic-ai/sdk/index.mjs --bundle --format=esm --platform=browser --minify --outfile=vendor/anthropic-sdk.js",
    "test:e2e": "node scripts/build-extension.mjs chrome && HEMLINE_E2E=1 vitest run tests/extension.e2e.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.0",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
