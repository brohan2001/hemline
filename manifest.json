{
  "manifest_version": 3,
  "name": "Hemline",
  "version": "2.0.0",
  "description": "Tailors your LaTeX resume and cover letter to any job posting with your own Claude or free Gemini/Groq key, plus H-1B filtering and ATS auto-fill.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "clipboardWrite",
    "offscreen"
  ],
  "host_permissions": [
    "https://jseek.co/*",
    "https://*.linkedin.com/*",
    "https://*.jobright.ai/*",
    "https://*.indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://www.ziprecruiter.com/*",
    "https://builtin.com/*",
    "https://*.builtin.com/*",
    "https://builtinnyc.com/*",
    "https://builtinboston.com/*",
    "https://builtinchicago.com/*",
    "https://builtincolorado.com/*",
    "https://builtinla.com/*",
    "https://builtinaustin.com/*",
    "https://builtinsf.com/*",
    "https://builtinseattle.com/*",
    "https://wellfound.com/*",
    "https://www.dice.com/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.icims.com/*",
    "https://jobs.smartrecruiters.com/*",
    "https://*.bamboohr.com/*",
    "https://*.jazz.co/*",
    "https://*.applytojob.com/*",
    "https://jobs.rippling.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.cerebras.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://jseek.co/*",
        "https://*.linkedin.com/*",
        "https://*.jobright.ai/*",
        "https://*.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://www.ziprecruiter.com/*",
        "https://builtin.com/*",
        "https://*.builtin.com/*",
        "https://builtinnyc.com/*",
        "https://builtinboston.com/*",
        "https://builtinchicago.com/*",
        "https://builtincolorado.com/*",
        "https://builtinla.com/*",
        "https://builtinaustin.com/*",
        "https://builtinsf.com/*",
        "https://builtinseattle.com/*",
        "https://wellfound.com/*",
        "https://www.dice.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.icims.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.bamboohr.com/*",
        "https://*.jazz.co/*",
        "https://*.applytojob.com/*",
        "https://jobs.rippling.com/*"
      ],
      "js": [
        "site_configs.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "h1b_data.json"
      ],
      "matches": [
        "https://jseek.co/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "*://*/*",
    "http://localhost:4567/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hemline",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
